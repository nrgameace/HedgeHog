# Hedgehog backend configuration.
#
# Copy this file to `backend/.env` and fill in the values:
#
#     cp backend/.env.example backend/.env
#
# `backend/.env` is gitignored, so real keys never reach the repo.
# Loaded at app startup by app/settings.py.

# --- Model (Qwen on Akamai) ------------------------------------------------
# Leave MOCK_MODEL=true (or unset) and the app runs end to end without an
# endpoint: anything that would call the model falls back to curated defaults.
# Set it to exactly "false" to start making real calls.
MOCK_MODEL=true

# Base URL of the inference endpoint. "/chat/completions" is appended, so give
# the part up to and including /v1. A trailing slash is stripped for you.
# e.g. https://my-endpoint.akamai.example/v1
AKAMAI_API_BASE_URL=

# Model identifier the endpoint expects, e.g. qwen3-32b
AKAMAI_CHAT_MODEL=

# Sent as "Authorization: Bearer <key>". Leave blank if the endpoint is open.
AKAMAI_API_KEY=

# --- Kalshi ----------------------------------------------------------------
# No credentials needed: market data is public and the demo places no orders.
# Point at the demo environment instead of production if you ever want to:
# https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_BASE_URL=
